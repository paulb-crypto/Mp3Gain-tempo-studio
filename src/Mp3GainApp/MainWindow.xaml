<!-- 
  =================================================================================================
  FILE: MainWindow.xaml
  LOCATION: Mp3GainApp/MainWindow.xaml
 
  WHAT THIS FILE DOES:
    This file defines the entire visual user interface of the desktop application using
    Windows 11 Fluent Design (modern cards, rounded sliders, dark theme, and rich controls).
 
  HOW IT RELATES TO THE APP:
    - Connects directly to MainViewModel.cs through WPF Data Binding.
    - Displays the song's album art, measured loudness (LUFS, RMS, Peak), and clipping indicators.
    - Provides interactive sliders and direct numeric text boxes for Volume Gain (dB) and Tempo (BPM).
    - Offers one-click DJ and streaming presets (Spotify -14 LUFS, Club 128, Workout 140).
    - Provides playback transport controls with -5s / +5s skipping and full keyboard navigation.
    - Provides "Save Changes to MP3", "Save Copy As...", and "Revert to Original File" buttons.
  =================================================================================================
-->
<ui:FluentWindow x:Class="Mp3GainApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:Mp3GainApp.Converters"
        xmlns:vm="clr-namespace:Mp3GainApp.ViewModels"
        mc:Ignorable="d"
        Title="MP3 Gain &amp; Tempo Studio" 
        Height="840" Width="940"
        MinHeight="700" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Focusable="True">

    <!-- Connect this window to our MainViewModel "brain" -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Value Converters (Format numbers into friendly text and colors) -->
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStr" />
        <converters:GainDisplayConverter x:Key="GainDisplay" />
        <converters:ClippingColorConverter x:Key="ClippingColor" />
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Windows 11 Title Bar -->
            <RowDefinition Height="*" />    <!-- Row 1: Main Content Workspace -->
            <RowDefinition Height="Auto" /> <!-- Row 2: Status Bar at bottom -->
        </Grid.RowDefinitions>

        <!-- ========================================================================================= -->
        <!-- ROW 0: WINDOWS 11 TITLE BAR                                                               -->
        <!-- ========================================================================================= -->
        <ui:TitleBar Grid.Row="0" Title="MP3 Gain &amp; Tempo Studio" />

        <!-- ========================================================================================= -->
        <!-- ROW 1: SCROLLABLE WORKSPACE                                                               -->
        <!-- ========================================================================================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,16">
            <StackPanel MaxWidth="880">

                <!-- Header area with App Title and "Open MP3" button -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="MP3 Gain &amp; Tempo Studio" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="ITU-R BS.1770 LUFS Loudness, WSOLA Phase-Aligned Tempo Calibration &amp; Anti-Clipping Limiter" 
                                   FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Open File Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding OpenFileCommand}"
                            Padding="16,8"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="Open an MP3 audio file (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0" />
                            <TextBlock Text="Open MP3 File" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- SECTION A: Welcome / Drag & Drop card (Shown only when NO song is loaded) -->
                <Border Style="{StaticResource FluentCard}"
                        Visibility="{Binding IsFileLoaded, Converter={StaticResource InverseBoolToVis}}"
                        Height="360"
                        Background="#0DFFFFFF"
                        BorderBrush="#25FFFFFF"
                        BorderThickness="1.5"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="56" Foreground="#60FFFFFF" Margin="0,0,0,16" />
                        <TextBlock Text="No MP3 File Loaded" FontSize="18" FontWeight="SemiBold" Foreground="#DDDDDD" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag and drop an MP3 here, or click 'Open MP3 File' to get started" 
                                   FontSize="13" Foreground="#888888" HorizontalAlignment="Center" Margin="0,6,0,16" />
                        <Button Command="{Binding OpenFileCommand}" HorizontalAlignment="Center" Padding="20,10" Cursor="Hand" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" />
                                <TextBlock Text="Browse MP3 Files..." FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Shortcuts: Spacebar = Play/Pause | Left/Right = Skip 5s | Ctrl+O = Open | Ctrl+S = Save" 
                                   FontSize="11" Foreground="#666666" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- SECTION B: Active Workspace (Shown when a song IS loaded) -->
                <StackPanel Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVis}}">

                    <!-- CARD 1: Track Information & Album Artwork Banner -->
                    <Border Style="{StaticResource FluentCard}" Background="#16FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Embedded Album Artwork Picture -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="8" Background="#26FFFFFF" Margin="0,0,16,0" ClipToBounds="True">
                                <Grid>
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="36" Foreground="#55FFFFFF" 
                                                   Visibility="{Binding CurrentFile.AlbumArt, Converter={StaticResource InverseBoolToVis}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding CurrentFile.AlbumArt}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- Song Title, Artist, and Album Name -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentFile.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentFile.Artist}" FontSize="14" Foreground="#CCCCCC" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding CurrentFile.Album}" FontSize="12" Foreground="#888888" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Song Length & Bitrate Badges -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Style="{StaticResource MetricBadge}">
                                    <TextBlock Text="{Binding CurrentFile.Duration, Converter={StaticResource TimeSpanToStr}, StringFormat='⏱ {0}'}" FontSize="12" Foreground="#D0D0D0" />
                                </Border>
                                <Border Style="{StaticResource MetricBadge}" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CurrentFile.BitrateKbps, StringFormat='🎵 {0} kbps'}" FontSize="12" Foreground="#D0D0D0" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 2: Loudness Analysis & Auto-Gain Recommendation -->
                    <Border Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Loudness Diagnostics &amp; ITU-R BS.1770 Metering" FontSize="14" FontWeight="SemiBold" Foreground="#EEEEEE" />
                                
                                <!-- One-click button to automatically set optimal gain -->
                                <Button HorizontalAlignment="Right" 
                                        Command="{Binding ApplyRecommendedGainCommand}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Cursor="Hand"
                                        ToolTip="Calibrate loudness to industry -14 LUFS streaming target while preventing clipping">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Wand24" Margin="0,0,6,0" />
                                        <TextBlock Text="Apply Auto-Gain (-14 LUFS)" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 4 Diagnostic Metric Tiles -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Peak Volume Level -->
                                <Border Grid.Column="0" Background="#14FFFFFF" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Peak Level" FontSize="11" Foreground="#888888" />
                                        <TextBlock Text="{Binding AnalysisResult.PeakSummary}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 2: Perceived Loudness (LUFS) -->
                                <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="Integrated Loudness" FontSize="11" Foreground="#888888" />
                                        <TextBlock Text="{Binding AnalysisResult.LufsSummary}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 3: Detected Native Song Tempo -->
                                <Border Grid.Column="2" Background="#14FFFFFF" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="Detected Tempo" FontSize="11" Foreground="#888888" />
                                        <TextBlock Text="{Binding AnalysisResult.BpmSummary}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 4: Sound Quality / Clipping Indicator -->
                                <Border Grid.Column="3" Background="#14FFFFFF" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Clipping Status" FontSize="11" Foreground="#888888" />
                                        <TextBlock Text="{Binding AnalysisResult.StatusSummary}" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding AnalysisResult.IsClipping, Converter={StaticResource ClippingColor}}" 
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Adjustment Sliders (Volume Gain & BPM) -->
                    <Border Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <TextBlock Text="Adjust Gain &amp; Beats Per Minute" FontSize="14" FontWeight="SemiBold" Foreground="#EEEEEE" Margin="0,0,0,14" />

                            <!-- 1. Volume Gain Slider (-15 dB to +15 dB) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Volume Gain:" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding GainText}" FontSize="13" FontWeight="Bold" Foreground="#0099FF" Margin="6,0,8,0" VerticalAlignment="Center" />
                                        
                                        <!-- Direct numeric input box for Gain -->
                                        <TextBox Text="{Binding GainInputText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                 Width="58" Height="24" 
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                 FontSize="11" FontWeight="SemiBold"
                                                 Background="#20FFFFFF" Foreground="#0099FF" BorderBrush="#33FFFFFF" 
                                                 ToolTip="Type exact gain value in dB (e.g. +3.5 or -2.0) and press Enter" />
                                        <TextBlock Text="dB" FontSize="11" Foreground="#888888" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Gain Preset Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding SetPresetSpotifyCommand}" Padding="8,2" FontSize="11" Margin="0,0,4,0" Cursor="Hand" ToolTip="Set gain to Spotify -14 LUFS loudness standard">
                                            <TextBlock Text="Spotify (-14 LUFS)" />
                                        </Button>
                                        <Button Command="{Binding ResetGainCommand}" Padding="8,2" FontSize="11" Cursor="Hand" ToolTip="Reset volume gain to untouched 0.0 dB">
                                            <TextBlock Text="Reset (0 dB)" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Slider Grid.Row="1" Style="{StaticResource ModernSlider}"
                                        Minimum="-15.0" Maximum="15.0" SmallChange="0.5" LargeChange="1.0"
                                        Value="{Binding GainDb, Mode=TwoWay}" />
                            </Grid>

                            <!-- Anti-Clipping Limiter Toggle Switch -->
                            <Border Background="#12FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Prevent Audio Clipping (Soft-Knee Peak Limiter)" FontWeight="Medium" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="Mathematically guarantees output stays under 0 dBFS without harsh distortion even with high gain" 
                                                   FontSize="11" Foreground="#888888" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" IsChecked="{Binding PreventClipping, Mode=TwoWay}" 
                                              Content="Active" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 2. Tempo / BPM Slider with micro +/- 1 BPM buttons and Direct Numeric Input -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tempo (BPM):" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TargetBpm, StringFormat='{}{0:F1} BPM'}" FontSize="13" FontWeight="Bold" Foreground="#0099FF" Margin="6,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TempoPercentText, StringFormat=' ({0})'}" FontSize="12" Foreground="#888888" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        
                                        <!-- Direct numeric input box for BPM -->
                                        <TextBox Text="{Binding BpmInputText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                 Width="58" Height="24" 
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                                 FontSize="11" FontWeight="SemiBold"
                                                 Background="#20FFFFFF" Foreground="#0099FF" BorderBrush="#33FFFFFF" 
                                                 ToolTip="Type exact target BPM (e.g. 126.5) and press Enter" />
                                    </StackPanel>

                                    <!-- Quick Tempo Preset and Nudge Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding DecreaseBpmCommand}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Cursor="Hand" Content="-1" ToolTip="Decrease tempo by 1 BPM" />
                                        <Button Command="{Binding IncreaseBpmCommand}" Padding="6,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand" Content="+1" ToolTip="Increase tempo by 1 BPM" />
                                        <Button Command="{Binding SetPresetClub128Command}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Cursor="Hand" Content="Club 128" ToolTip="Calibrate to standard House / Club 128 BPM" />
                                        <Button Command="{Binding SetPresetWorkout140Command}" Padding="6,2" FontSize="11" Margin="0,0,6,0" Cursor="Hand" Content="Workout 140" ToolTip="Calibrate to high-energy Workout / Cardio 140 BPM" />
                                        <Button Command="{Binding ResetBpmCommand}" Padding="6,2" FontSize="11" Cursor="Hand" Content="Reset BPM" ToolTip="Reset tempo to song's original detected BPM" />
                                    </StackPanel>
                                </Grid>

                                <Slider Grid.Row="1" Style="{StaticResource ModernSlider}"
                                        Minimum="50.0" Maximum="200.0" SmallChange="0.5" LargeChange="2.0"
                                        Value="{Binding TargetBpm, Mode=TwoWay}" />
                            </Grid>

                            <!-- Tempo Mode: Turntable / Vinyl vs Key Lock (Master Tempo) -->
                            <Border Background="#12FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tempo Mode: " FontSize="13" FontWeight="Medium" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding TempoModeName}" FontSize="13" FontWeight="Bold" Foreground="#0099FF" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TempoModeDescription}" 
                                                   FontSize="11" Foreground="#A0A0A0" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="1" 
                                              IsChecked="{Binding KeyLock, Mode=TwoWay}" 
                                              Content="Key Lock (Master Tempo)" 
                                              FontWeight="SemiBold" 
                                              VerticalAlignment="Center"
                                              ToolTip="Unchecked: Turntable / Vinyl Mode (100% punchy club sound). Checked: Keeps vocal pitch fixed." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: Real-Time Audio Preview Player -->
                    <Border Style="{StaticResource FluentCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Real-Time Audio Preview" FontSize="14" FontWeight="SemiBold" Foreground="#EEEEEE" />
                                    <TextBlock Text="{Binding TempoModeName, StringFormat='({0})'}" FontSize="11" Foreground="#777777" Margin="8,2,0,0" />
                                </StackPanel>
                                
                                <!-- Red indicator that lights up if clipping occurs -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding IsLiveClipping, Converter={StaticResource BoolToVis}}">
                                    <Ellipse Width="10" Height="10" Fill="#FF2222" Margin="0,0,6,0" />
                                    <TextBlock Text="CLIPPING DETECTED" FontSize="11" FontWeight="Bold" Foreground="#FF4444" />
                                </StackPanel>
                            </Grid>

                            <!-- Scrubber Timeline & Playback Position (With instant jump-to-point seeking) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding CurrentTime, Converter={StaticResource TimeSpanToStr}}" FontSize="12" Foreground="#A0A0A0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                
                                <!-- Timeline Slider: Click anywhere or drag to skip through time! -->
                                <Slider x:Name="TimelineSlider" 
                                        Grid.Column="1" 
                                        Style="{StaticResource ModernSlider}"
                                        Minimum="0.0" Maximum="1.0"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                        MouseMove="TimelineSlider_MouseMove"
                                        Value="{Binding PlaybackProgressFraction, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2" Text="{Binding TotalTime, Converter={StaticResource TimeSpanToStr}}" FontSize="12" Foreground="#A0A0A0" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Visual VU Peak Meter bar -->
                            <Grid Margin="0,0,0,14" Height="6">
                                <ProgressBar Minimum="0.0" Maximum="1.0" Value="{Binding LivePeakMeter, Mode=OneWay}" 
                                             Foreground="{Binding IsLiveClipping, Converter={StaticResource ClippingColor}}" 
                                             Background="#20FFFFFF" />
                            </Grid>

                            <!-- Play/Pause, Skip, and Stop Transport Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                
                                <!-- Skip Backward 5s -->
                                <Button Command="{Binding SkipBackwardCommand}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="Skip backward 5 seconds (Left Arrow)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" Margin="0,0,4,0" />
                                        <TextBlock Text="-5s" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>

                                <!-- The Preview Audio Button (Displays Play/Pause icon and text) -->
                                <Button Command="{Binding PlayPauseCommand}" Padding="24,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="Play or pause audio preview (Spacebar)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding PlayButtonIcon}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding PlayButtonText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Skip Forward 5s -->
                                <Button Command="{Binding SkipForwardCommand}" Padding="12,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="Skip forward 5 seconds (Right Arrow)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,4,0" />
                                        <TextBlock Text="+5s" FontSize="12" FontWeight="Medium" />
                                    </StackPanel>
                                </Button>

                                <!-- Stop Button -->
                                <Button Command="{Binding StopCommand}" Padding="16,8" Cursor="Hand" ToolTip="Stop audio and rewind to beginning (Esc)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 5: Bottom Actions (Revert, Export Copy, Save Changes) -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 1-Click Revert Button -->
                        <Button Grid.Column="1" 
                                Command="{Binding RevertToOriginalCommand}"
                                Padding="16,10"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                ToolTip="Undo modifications and restore original file from backup (Ctrl+Z)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUndo24" Margin="0,0,8,0" Foreground="#FFA500" />
                                <TextBlock Text="Revert to Original" FontWeight="Medium" Foreground="#FFA500" />
                            </StackPanel>
                        </Button>

                        <!-- Export Copy As... Button -->
                        <Button Grid.Column="2" 
                                Command="{Binding SaveCopyAsCommand}"
                                Padding="18,10"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                Background="#2AFFFFFF"
                                ToolTip="Export a separate new MP3 copy without overwriting the original file (Ctrl+Shift+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Share24" Margin="0,0,8,0" Foreground="#EEEEEE" />
                                <TextBlock Text="Save Copy As..." FontWeight="SemiBold" Foreground="#EEEEEE" />
                            </StackPanel>
                        </Button>

                        <!-- Primary Save Changes Button -->
                        <Button Grid.Column="3" 
                                Command="{Binding SaveChangesCommand}"
                                Padding="22,10"
                                Cursor="Hand"
                                Background="#0078D4"
                                ToolTip="Saves a clearly labeled new MP3 (e.g. 'Song (Edited).mp3') leaving your original file untouched (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0" Foreground="#FFFFFF" />
                                <TextBlock Text="Save Edited MP3" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================================= -->
        <!-- ROW 2: STATUS BAR (Bottom of Window)                                                      -->
        <!-- ========================================================================================= -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                
                <!-- Shield icon indicating a safe backup exists -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                            Visibility="{Binding HasBackup, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="#44BB44" Margin="0,0,4,0" />
                    <TextBlock Text="Pristine Backup Available" FontSize="11" Foreground="#44BB44" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Busy / Processing Overlay (Dim background with spinner during analysis & save) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" 
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="#252525" CornerRadius="12" Padding="28" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing Width="48" Height="48" IsIndeterminate="True" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding BusyMessage}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding BusyProgress}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</ui:FluentWindow>
